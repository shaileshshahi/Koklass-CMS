{
  "name": "Koklass — Ember",
  "version": "1.1.0",
  "description": "Theme anchored on the Koklass logo color #EC3876. Cool charcoal neutrals; light + dark.",
  "spacingBase": 4,
  "color": {
    "brand": {
      "primary": "#EC3876",
      "primaryHover": "#D31255",
      "primaryDark": "#AF0D45",
      "onPrimary": "#FFFFFF",
      "primaryDarkMode": "#F34F87",
      "accent": "#FFC93C",
      "accentHover": "#F5B820",
      "onAccent": "#2A1E00",
      "secondary": "#2E3440"
    },
    "semantic": {
      "success": "#16885C",
      "successBright": "#2FBF71",
      "onSuccess": "#FFFFFF",
      "warning": "#FFB020",
      "warningText": "#8A5A00",
      "onWarning": "#2A1E00",
      "danger": "#D0342C",
      "dangerBright": "#F0564E",
      "onDanger": "#FFFFFF",
      "info": "#2270E0",
      "onInfo": "#FFFFFF"
    },
    "neutral": {
      "0": "#FFFFFF",
      "25": "#FBFBFC",
      "50": "#F7F8FA",
      "100": "#EFF1F4",
      "200": "#E3E6EB",
      "300": "#CBD0D8",
      "400": "#9AA2AE",
      "500": "#6B7482",
      "600": "#4E5563",
      "700": "#3A4150",
      "800": "#2A303C",
      "850": "#242B36",
      "900": "#1C222B",
      "950": "#14181F",
      "975": "#0E1218"
    }
  },
  "theme": {
    "light": {
      "bg": "#F7F8FA",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#EFF1F4",
      "line": "#E3E6EB",
      "lineStrong": "#CBD0D8",
      "fg": "#1E232C",
      "fgMuted": "#4E5563",
      "fgFaint": "#8B93A1",
      "overlayScrim": "rgba(20, 24, 31, 0.50)",
      "primary": "#EC3876",
      "primaryHover": "#D31255"
    },
    "dark": {
      "bg": "#14181F",
      "surface": "#1C222B",
      "surfaceRaised": "#242B36",
      "surfaceSunken": "#0E1218",
      "line": "#2E3642",
      "lineStrong": "#3A4150",
      "fg": "#F2F4F7",
      "fgMuted": "#A9B1BC",
      "fgFaint": "#767E8B",
      "overlayScrim": "rgba(6, 8, 12, 0.68)",
      "primary": "#F34F87",
      "primaryHover": "#EC3876"
    }
  },
  "typography": {
    "sans": "Nunito, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "displayWeight": 800,
    "headingWeight": 700,
    "bodyWeight": 400,
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "lineHeight": {
      "tight": 1.2,
      "snug": 1.35,
      "normal": 1.55
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16, 18, 24, 0.08)",
    "md": "0 2px 6px rgba(16, 18, 24, 0.08), 0 1px 2px rgba(16, 18, 24, 0.06)",
    "lg": "0 12px 32px -8px rgba(16, 18, 24, 0.18)",
    "dark": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.45)",
      "md": "0 2px 6px rgba(0, 0, 0, 0.40), 0 1px 2px rgba(0, 0, 0, 0.35)",
      "lg": "0 12px 32px -8px rgba(0, 0, 0, 0.60)"
    }
  },
  "ramp": {
    "ember": {
      "100": "#FEE6EF",
      "200": "#FCC9DB",
      "300": "#FA9EBE",
      "400": "#F46697",
      "500": "#EC3876",
      "600": "#DD1359",
      "700": "#AF0D45",
      "800": "#840B35",
      "900": "#5B0623"
    }
  }
